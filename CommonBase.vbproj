<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>CommonBase</RootNamespace>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="CommonBase.Logic\CommonBase.Logic.vbproj" />
  </ItemGroup>

  <!-- This project lives at the repo root, so exclude the sibling project folders
       from its default source globs. -->
  <ItemGroup>
    <Compile Remove="CommonBase.Logic\**" />
    <Compile Remove="CommonBase.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

</Project>